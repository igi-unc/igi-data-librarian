# Optional. Anthropic API key for the Claude chat assistant (DMs and @mentions).
# Leave unset to run in basic mode: the bot answers chat with a list of its slash
# commands, and all slash commands work normally. Restart the bot after setting it.
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Required. Which librarian instance this process runs (name, commands, registry location).
DATA_LIBRARIAN_INSTANCE=instances/igi.toml

# Optional. Override the instance's [registry] dir, which holds the monitored sequencing/
# and references/ directories plus the registry TSVs and SQLite database.
# DATA_LIBRARIAN_REGISTRY_DIR=/path/to/registry

# Optional. IGI LIMS API tokens (see [lims] in instances/igi.toml). The read token checks the
# tube being accessioned; the write token records approved datasets on it.
# IGI_LIMS_READ_TOKEN=YOUR_LIMS_READ_TOKEN
# IGI_LIMS_WRITE_TOKEN=YOUR_LIMS_WRITE_TOKEN

# Optional, uncomment and set when running without the Slack CLI (python3 app.py).
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Required for OAuth (app_oauth.py). Set your app's OAuth credentials.
# SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
# SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
# SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
# SLACK_REDIRECT_URI=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/slack/oauth_redirect

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL
